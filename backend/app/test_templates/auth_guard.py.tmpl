"""ChangeSentry verification test - template: auth_guard (approved, parameterised).

Contract: a route that performs a privileged operation must reject callers who
are unauthenticated or lack the admin role (HTTP 401/403). A revision where the
route is not registered (HTTP 404) also refuses the operation. A failing test
means the route accepted such a caller.
"""
import importlib

DISPATCH_MODULE = $dispatch_module
METHOD = $method
PATH = $path
PAYLOAD = $payload
MARKER = "CHANGESENTRY_INVARIANT_VIOLATED"
REJECTED = (401, 403, 404)


def _call(user):
    dispatch = importlib.import_module(DISPATCH_MODULE).dispatch
    response = dispatch(METHOD, PATH, body=dict(PAYLOAD), user=user)
    print(f"{METHOD} {PATH} user={user} payload={PAYLOAD} -> {response.status} {response.body}")
    return response


def test_unauthenticated_caller_is_rejected():
    response = _call(None)
    assert response.status in REJECTED, (
        f"{MARKER}: unauthenticated {METHOD} {PATH} returned {response.status} {response.body}"
    )


def test_non_admin_caller_is_rejected():
    response = _call({"id": "customer-42", "role": "customer"})
    assert response.status in REJECTED, (
        f"{MARKER}: non-admin {METHOD} {PATH} returned {response.status} {response.body}"
    )
