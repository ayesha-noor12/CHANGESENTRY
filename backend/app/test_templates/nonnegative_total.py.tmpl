"""ChangeSentry verification test - template: nonnegative_total (approved, parameterised).

Contract: a function that computes a monetary amount must never return a
negative value for supported inputs. Percent-like parameters are drawn from
the supported 0-100 range; amounts from non-negative values. A failing test
lists the input combinations that produced a negative result.

CASES is fixed when the test is rendered, so the base and head revisions are
called with exactly the same arguments.
"""
import importlib

TARGET_MODULE = $module
TARGET_FUNCTION = $function
CASES = $cases
MARKER = "CHANGESENTRY_INVARIANT_VIOLATED"


def test_total_is_never_negative():
    func = getattr(importlib.import_module(TARGET_MODULE), TARGET_FUNCTION)
    violations, checked = [], 0
    for kwargs in CASES:
        result = func(**kwargs)
        checked += 1
        if result < 0:
            violations.append((kwargs, result))
    print(f"{TARGET_MODULE}.{TARGET_FUNCTION}: checked {checked} input combinations, "
          f"{len(violations)} negative result(s)")
    for kwargs, result in violations[:5]:
        print(f"  {TARGET_FUNCTION}(**{kwargs}) = {result}")
    assert not violations, (
        f"{MARKER}: {len(violations)} of {checked} combinations returned a negative amount; "
        f"first: {TARGET_FUNCTION}(**{violations[0][0]}) = {violations[0][1]}"
    )
