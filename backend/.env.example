# Copy to backend/.env and fill in. Never commit .env or expose these to the frontend.
# Base URL and model id: copy them from the Nebius Token Factory quickstart / model catalog,
# then run `python -m scripts.check_nebius` to confirm.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=
TAVILY_API_KEY=
# Comma-separated list of frontend origins allowed to call the API directly
ALLOWED_ORIGINS=http://localhost:3000
